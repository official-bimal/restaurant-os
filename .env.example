# A NEW, empty PostgreSQL database dedicated to Restaurant OS.
# Never point this at the customer_os / CinePaila database.
DATABASE_URL="postgresql://USER:PASSWORD@localhost:5432/restaurant_os"
# 32+ random bytes, hex. Generate with: node -e "console.log(require('crypto').randomBytes(32).toString('hex'))"
SESSION_SECRET="CHANGE_ME"
# Set to 1 only for the embedded dev database (npm run db:dev)
# DB_POOL_MAX=1
# Public address guests reach. QR codes encode this. Use your real domain in production;
# for testing on a phone use your computer's LAN address, e.g. http://192.168.1.10:3000
APP_URL="http://localhost:3000"
# How many reverse proxies / load balancers sit in front of the app (e.g. 1 on most hosts).
# Needed to rate limit sign-ins per network. Leave 0 if the app is reached directly: the
# X-Forwarded-For header is then ignored because anyone could forge it.
TRUSTED_PROXY_HOPS=0

# Web Push (alerts when the app is closed). Generate a pair with: npx web-push generate-vapid-keys
# Leave all three empty to switch background alerts off. Keep the private key secret.
VAPID_PUBLIC_KEY=
VAPID_PRIVATE_KEY=
VAPID_SUBJECT=mailto:you@yourdomain.com

# Secret for the scheduled alert check (bills left open, stock still low). 16+ random characters.
# Call GET/POST /api/cron/alerts with the header  Authorization: Bearer <this value>  from any scheduler.
# Leave empty to switch it off.
CRON_SECRET=
# Optional: your own OSRM routing server, for real road distances (only coordinates are sent). Empty = straight line x road factor.
ROUTING_URL=
# Optional: a Nominatim-compatible geocoding server to turn a typed street address into a location (only the address text is sent).
# Empty = off; staff paste a location or map link instead.
GEOCODER_URL=
GEOCODER_COUNTRY=

# Sending campaign messages (off unless MESSAGING_PROVIDER is set). One of: twilio, sparrow, webhook. The owner confirms every send.
MESSAGING_PROVIDER=
MESSAGING_DAILY_LIMIT=200
# twilio:
TWILIO_ACCOUNT_SID=
TWILIO_AUTH_TOKEN=
TWILIO_FROM=
# sparrow (Sparrow SMS, Nepal):
SPARROW_TOKEN=
SPARROW_FROM=
# webhook (your own URL; receives JSON {"to","text"}):
MESSAGING_WEBHOOK_URL=
MESSAGING_WEBHOOK_TOKEN=

# Automatic campaigns (birthday, win-back) run from a timer inside the app (every 15 minutes). Set to off to use /api/cron/automations
# with CRON_SECRET from your own scheduler instead.
AUTOMATION_TIMER=

# Optional: shows a "Contact us" button on the public landing page.
NEXT_PUBLIC_CONTACT_EMAIL=

# Emailing the owner's daily summary (off unless EMAIL_PROVIDER is set): resend (RESEND_API_KEY + EMAIL_FROM) or webhook (EMAIL_WEBHOOK_URL).
EMAIL_PROVIDER=
RESEND_API_KEY=
EMAIL_FROM=
EMAIL_WEBHOOK_URL=
EMAIL_WEBHOOK_TOKEN=
